# Copy values into your shell or GitHub Actions secrets. Do not commit .env.
DEEPSEEK_API_KEY=replace-me
SCREENING_MODEL=deepseek-v4-flash
REVIEW_MODEL=deepseek-v4-pro
SITE_URL=http://127.0.0.1:8000
ARXIV_CATEGORIES=stat.ML,cs.LG,physics.data-an,hep-ex
MAX_CANDIDATES=60
BOOTSTRAP_RESULTS=120
METHOD_CANDIDATE_SLOTS=40
HEP_APPLICATION_SLOTS=10
DISCOVERY_SLOTS=10
MAX_DEEP_REVIEWS=5
MIN_DEEP_REVIEWS=3
PUBLISH_THRESHOLD=0.55
REVIEW_THRESHOLD=0.45
REQUEST_TIMEOUT_SECONDS=90
API_TIME_BUDGET_SECONDS=1440
MAX_CONSECUTIVE_API_FAILURES=5
MAX_PROMPT_TOKENS=300000
REANALYSIS_SLOTS=5
CHECKPOINT_INTERVAL=5
SCREENING_CACHE_HIT_PRICE_PER_MILLION_RMB=0.02
SCREENING_INPUT_PRICE_PER_MILLION_RMB=1
SCREENING_OUTPUT_PRICE_PER_MILLION_RMB=2
REVIEW_CACHE_HIT_PRICE_PER_MILLION_RMB=0.025
REVIEW_INPUT_PRICE_PER_MILLION_RMB=3
REVIEW_OUTPUT_PRICE_PER_MILLION_RMB=6
FEEDBACK_REPOSITORY=your-name/hepml-digest
