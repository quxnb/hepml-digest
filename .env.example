# Copy values into your shell or GitHub Actions secrets. Do not commit .env.
DEEPSEEK_API_KEY=replace-me
# Use the relay's OpenAI-compatible base URL, often ending in /v1.
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANALYSIS_REVISION=1
SCREENING_MODEL=deepseek-v4-flash
REVIEW_MODEL=deepseek-v4-pro
REVIEW_MAX_TOKENS=8192
REVIEW_REASONING_EFFORT=low
SITE_URL=http://127.0.0.1:8000
ARXIV_CATEGORIES=stat.ML,cs.LG,physics.data-an,hep-ex
MAX_CANDIDATES=60
BOOTSTRAP_RESULTS=120
BACKFILL_LOOKBACK_DAYS=7
BACKFILL_MAX_PAGES=25
METHOD_CANDIDATE_SLOTS=40
HEP_APPLICATION_SLOTS=10
DISCOVERY_SLOTS=10
MAX_DEEP_REVIEWS=5
PUBLISH_THRESHOLD=0.55
REVIEW_THRESHOLD=0.45
REQUEST_TIMEOUT_SECONDS=120
API_TIME_BUDGET_SECONDS=1440
SCREENING_BUDGET_FRACTION=0.7
MAX_CONSECUTIVE_API_FAILURES=5
MAX_PROMPT_TOKENS=300000
REANALYSIS_SLOTS=5
CHECKPOINT_INTERVAL=5
AGING_SLOTS=5
MAX_PAPER_FAILURES=3
ALERT_AFTER_RUNS=3
ALERT_BACKLOG_DAYS=7
MAX_ESTIMATED_COST_RMB=1
# Official off-peak prices checked on 2026-10-29; override for a relay.
SCREENING_CACHE_HIT_PRICE_PER_MILLION_RMB=0.02
SCREENING_INPUT_PRICE_PER_MILLION_RMB=1
SCREENING_OUTPUT_PRICE_PER_MILLION_RMB=4
REVIEW_CACHE_HIT_PRICE_PER_MILLION_RMB=0.15
REVIEW_INPUT_PRICE_PER_MILLION_RMB=4.5
REVIEW_OUTPUT_PRICE_PER_MILLION_RMB=13.5
FEEDBACK_REPOSITORY=your-name/hepml-digest
